<div class="clr widget form_data_manager_table">
    <table class="clr">
        <thead>
            <tr>
                <th><?= $this->trans('tl_wem_form_storage_data.field.0', [], 'contao_tl_wem_form_storage_data') ?></th>
                <th><?= $this->trans('tl_wem_form_storage_data.value.0', [], 'contao_tl_wem_form_storage_data') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($this->arrFormStorageDatas as $row): ?>
                <tr>
                    <td><?= $row['field_label'] ?></td>
                    <td>
                        <?php if ('upload' === $row['field_type'] && $row['is_uuid']): ?>
                            <a href="<?= $row['value'] ?>" target="_blank"><?= $row['value'] ?></a>
                        <?php else: ?>
                            <?= $row['value'] ?>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
</div>
