{
    "name": "webexmachina/contao-form-data-manager",
    "description": "Bundle for manage the form data",
    "keywords": ["form", "private data", "webexmachina", "module", "contao"],
    "type": "contao-bundle",
    "license": "LGPL-3.0+",
    "authors": [
        {
            "name": "Web ex Machina",
            "homepage": "https://www.webexmachina.fr",
            "email": "contact@webexmachina.fr",
            "role": "Developer"
        }
    ],
    "support": {
        "website": "https://www.webexmachina.fr",
        "issues": "https://github.com/Web-Ex-Machina/contao-form-data-manager/issues",
        "source": "https://github.com/Web-Ex-Machina/contao-form-data-manager"
    },
    "require": {
        "php": "^8.4",
        "contao/core-bundle": "^5.7",
        "contao/manager-plugin": "^2.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/translation-contracts": "^3.0",
        "webexmachina/contao-utils": "^2.0",
        "webexmachina/contao-personal-data-manager": "^1.3"
    },
    "require-dev": {
        "contao/manager-plugin": "@stable",
        "contao/easy-coding-standard": "@stable",
        "rector/rector": "@stable",
        "phpstan/phpstan": "@stable",
        "contao/contao-rector": "dev-main",
        "terminal42/notification_center": "^2.0"
    },
    "suggest": {
        "terminal42/notification_center": "Adds the ##useful_data## tokens to the form generator notification type"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0",
        "terminal42/notification_center": "<2.0"
    },
    "autoload": {
        "psr-4": {
            "WEM\\ContaoFormDataManagerBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "WEM\\ContaoFormDataManagerBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false,
            "contao-community-alliance/composer-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
